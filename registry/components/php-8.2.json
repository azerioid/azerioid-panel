{
  "id": "php-8.2",
  "display_name": "PHP 8.2",
  "category": "php",
  "description": "PHP 8.2 FPM runtime for sites",
  "managed": true,
  "system": false,
  "installable": true,
  "min_os": { "ubuntu": "24.04", "debian": "12", "el": "9" },
  "ports": [],
  "conflicts": [],
  "distros": {
    "ubuntu": {
      "packages": ["php8.2-fpm", "php8.2-cli"],
      "unit_name": "php8.2-fpm",
      "detect": { "packages": ["php8.2-fpm"], "unit": "php8.2-fpm", "command": "php8.2 -v" }
    },
    "debian": {
      "packages": ["php8.2-fpm", "php8.2-cli"],
      "unit_name": "php8.2-fpm",
      "detect": { "packages": ["php8.2-fpm"], "unit": "php8.2-fpm", "command": "php8.2 -v" }
    },
    "el": {
      "packages": ["php82-php-fpm", "php82-php-cli"],
      "unit_name": "php82-php-fpm",
      "detect": { "packages": ["php82-php-fpm"], "unit": "php82-php-fpm", "command": "php82 -v" }
    }
  },
  "preflight": { "min_disk_gb": 0.5, "min_ram_mb": 256 }
}
