  "category": "php",
  "description": "PHP 8.1 FPM runtime for sites",
  "managed": true,
  "system": false,
  "installable": true,
  "min_os": { "ubuntu": "24.04", "debian": "12", "el": "9" },
  "ports": [],
  "conflicts": [],
  "distros": {
    "ubuntu": {
      "packages": ["php8.1-fpm", "php8.1-cli"],
      "unit_name": "php8.1-fpm",
      "detect": { "packages": ["php8.1-fpm"], "unit": "php8.1-fpm", "command": "php8.1 -v" }
    },
    "debian": {
      "packages": ["php8.1-fpm", "php8.1-cli"],
      "unit_name": "php8.1-fpm",
      "detect": { "packages": ["php8.1-fpm"], "unit": "php8.1-fpm", "command": "php8.1 -v" }
    },
    "el": {
      "packages": ["php81-php-fpm", "php81-php-cli"],
      "unit_name": "php81-php-fpm",
      "detect": { "packages": ["php81-php-fpm"], "unit": "php81-php-fpm", "command": "php81 -v" }
    }
  },
  "preflight": { "min_disk_gb": 0.5, "min_ram_mb": 256 }
