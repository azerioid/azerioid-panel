{
  "id": "redis",
  "display_name": "Redis",
  "category": "cache",
  "description": "In-memory data store and cache",
  "managed": true,
  "system": false,
  "installable": true,
  "min_os": { "ubuntu": "24.04", "debian": "12", "el": "9" },
  "ports": [
    { "port": 6379, "bind": "127.0.0.1", "owner": "redis", "protocol": "tcp" }
  ],
  "conflicts": [],
  "distros": {
    "ubuntu": {
      "packages": ["redis-server"],
      "unit_name": "redis-server",
      "detect": { "packages": ["redis-server"], "unit": "redis-server", "command": "redis-server --version" },
      "secure": [
        "sed -i 's/^# bind .*/bind 127.0.0.1/' /etc/redis/redis.conf",
        "sed -i 's/^bind .*/bind 127.0.0.1/' /etc/redis/redis.conf",
        "sed -i 's/^# protected-mode .*/protected-mode yes/' /etc/redis/redis.conf",
        "sed -i 's/^protected-mode .*/protected-mode yes/' /etc/redis/redis.conf"
      ]
    },
    "debian": {
      "packages": ["redis-server"],
      "unit_name": "redis-server",
      "detect": { "packages": ["redis-server"], "unit": "redis-server", "command": "redis-server --version" },
      "secure": [
        "sed -i 's/^# bind .*/bind 127.0.0.1/' /etc/redis/redis.conf",
        "sed -i 's/^bind .*/bind 127.0.0.1/' /etc/redis/redis.conf",
        "sed -i 's/^# protected-mode .*/protected-mode yes/' /etc/redis/redis.conf",
        "sed -i 's/^protected-mode .*/protected-mode yes/' /etc/redis/redis.conf"
      ]
    },
    "el": {
      "packages": ["redis"],
      "unit_name": "redis",
      "detect": { "packages": ["redis"], "unit": "redis", "command": "redis-server --version" },
      "secure": [
        "sed -i 's/^bind .*/bind 127.0.0.1/' /etc/redis/redis.conf",
        "sed -i 's/^protected-mode .*/protected-mode yes/' /etc/redis/redis.conf"
      ]
    }
  },
  "preflight": { "min_disk_gb": 0.5, "min_ram_mb": 256 }
}
