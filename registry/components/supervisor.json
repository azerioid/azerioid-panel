{
  "id": "supervisor",
  "display_name": "Supervisor",
  "category": "process-manager",
  "description": "Process control for long-running user applications (Node.js, workers, scripts)",
  "managed": true,
  "system": false,
  "installable": true,
  "min_os": { "ubuntu": "24.04", "debian": "12", "el": "9" },
  "ports": [],
  "conflicts": [],
  "distros": {
    "ubuntu": {
      "packages": ["supervisor"],
      "unit_name": "supervisor",
      "detect": {
        "packages": ["supervisor"],
        "unit": "supervisor",
        "command": "supervisord --version"
      },
      "post_install": [],
      "secure": []
    },
    "debian": {
      "packages": ["supervisor"],
      "unit_name": "supervisor",
      "detect": {
        "packages": ["supervisor"],
        "unit": "supervisor",
        "command": "supervisord --version"
      },
      "post_install": [],
      "secure": []
    },
    "el": {
      "packages": ["supervisor"],
      "unit_name": "supervisord",
      "detect": {
        "packages": ["supervisor"],
        "unit": "supervisord",
        "command": "supervisord --version"
      },
      "post_install": [],
      "secure": []
    }
  },
  "preflight": { "min_disk_gb": 0.5, "min_ram_mb": 256 }
}
