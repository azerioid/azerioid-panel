[Unit]
Description=Stack Manager Laravel queue worker
After=network.target

[Service]
Type=simple
User=caddy
Group=caddy
WorkingDirectory=/usr/local/lib/lacmp-panel/web
ExecStart=/usr/bin/php8.4 /usr/local/lib/lacmp-panel/web/artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
